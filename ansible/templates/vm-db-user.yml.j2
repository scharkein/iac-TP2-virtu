#cloud-config
hostname: vm-db-01
manage_etc_hosts: true
ssh_pwauth: false
disable_root: true

# L'image Debian genericcloud fournit l'utilisateur par defaut "debian".
users:
  - default

# Cle publique generee sur le poste de controle : ~/.ssh/tp3_vm.pub
ssh_authorized_keys:
  - "{{ tp3_vm_ssh_pubkey }}"
