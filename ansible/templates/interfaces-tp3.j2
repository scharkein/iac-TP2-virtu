# TP3 - genere par Ansible (05-vlan-aware.yml). Sauvegarde : /etc/network/interfaces.pre-tp3
auto lo
iface lo inet loopback

auto {{ nat_if }}
iface {{ nat_if }} inet dhcp

iface {{ mgmt_if }} inet manual

# vmbr0 : bridge VLAN-aware. Le trafic non tague (PVID 1) reste utilisable :
# l'acces admin 192.168.56.x n'est donc pas coupe (cf. avertissement "lockout" du sujet).
auto vmbr0
iface vmbr0 inet static
    address {{ node_ip }}/24
    bridge-ports {{ mgmt_if }}
    bridge-stp off
    bridge-fd 0
    bridge-vlan-aware yes
    bridge-vids {{ vlan_ids | join(' ') }}

# Gestion taguee VLAN 99 (pas de gateway : la route par defaut reste celle du NAT)
auto vmbr0.99
iface vmbr0.99 inet static
    address {{ mgmt_vlan_ip }}/24

auto vmbr1
iface vmbr1 inet static
    address {{ guest_net }}.1/24
    bridge-ports none
    bridge-stp off
    bridge-fd 0
    post-up   echo 1 > /proc/sys/net/ipv4/ip_forward
    # Etat idempotent : supprimer les doublons eventuels, puis garantir une seule regle.
    post-up   while iptables -t nat -C POSTROUTING -s {{ guest_net }}.0/24 -o {{ nat_if }} -j MASQUERADE 2>/dev/null; do iptables -t nat -D POSTROUTING -s {{ guest_net }}.0/24 -o {{ nat_if }} -j MASQUERADE; done; iptables -t nat -A POSTROUTING -s {{ guest_net }}.0/24 -o {{ nat_if }} -j MASQUERADE
    post-down while iptables -t nat -C POSTROUTING -s {{ guest_net }}.0/24 -o {{ nat_if }} -j MASQUERADE 2>/dev/null; do iptables -t nat -D POSTROUTING -s {{ guest_net }}.0/24 -o {{ nat_if }} -j MASQUERADE; done

source /etc/network/interfaces.d/*
